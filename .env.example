# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEON_API_KEY: Personal or project Neon API key for `neon deploy` / `neon env pull`.
NEON_API_KEY="MY_NEON_API_KEY"

# Neon Postgres, Managed Better Auth & Object Storage
# Auto-populated into .env.local via `neon deploy` when NEON_API_KEY is present:
# DATABASE_URL=""
# DATABASE_URL_UNPOOLED=""
# NEON_AUTH_BASE_URL=""
# NEON_AUTH_JWKS_URL=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_ENDPOINT_URL_S3=""
# AWS_REGION=""

# ExoNovel Docs Admin & Key Wrapping
# ADMIN_EMAIL defaults to exonomyapp@gmail.com; DID_KEY_ENCRYPTION_SECRET is auto-generated in .env.local if omitted:
# ADMIN_EMAIL="exonomyapp@gmail.com"
# DID_KEY_ENCRYPTION_SECRET=""

# Custom OAuth provider credentials synced to Neon Auth when NEON_API_KEY is present
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Optional overrides for Google Docs & Drive Connected App flow:
# GOOGLE_DRIVE_REDIRECT_URI="https://exonovel.exosystems.net/api/oauth/google/callback"
# GOOGLE_DRIVE_SCOPES="https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/userinfo.email"
# Optional HashiCorp Vault Transit envelope wrapping (falls back to DID_KEY_ENCRYPTION_SECRET AES-256-GCM if unset):
# VAULT_ADDR=""
# VAULT_TOKEN=""
# VAULT_TRANSIT_KEY="exonovel"
# Optional GitHub OAuth credentials:
# GITHUB_OAUTH_CLIENT_ID=""
# GITHUB_OAUTH_CLIENT_SECRET=""

# Brevo Transactional Email (only BREVO_API_KEY on the server is a secret)
# Multi-sender routing on root exosystems.net (subdomain sending path dropped).
# Optional overrides only: built-in defaults already live in crates/server/src/notify.rs
# and are auto-written to /opt/exonovel/env by .github/workflows/deploy.yml on every deploy.
# BREVO_SENDER_NOTES_EMAIL="notes@exosystems.net"
# BREVO_SENDER_NOTES_NAME="Notes from ExoNovel"
# BREVO_SENDER_NOREPLY_EMAIL="noreply@exosystems.net"
# BREVO_SENDER_NOREPLY_NAME="Exosystems"
# BREVO_SENDER_SUPPORT_EMAIL="support@exosystems.net"
# BREVO_SENDER_SUPPORT_NAME="ExoSupport"

# Optional Headless Inference Keys for OpenCode Maturity Proposal Synthesis (ADR 005-004)
# GEMINI_API_KEY already listed above for Google AI Studio
# NVIDIA_NIM_API_KEY=""
# OPENROUTER_API_KEY=""
# GROQ_API_KEY=""
# CEREBRAS_API_KEY=""
# MISTRAL_API_KEY=""
